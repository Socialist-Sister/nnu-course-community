# Copy this file to .env beside package.json. Leave blank until a sender is available.
# These are the WEBSITE sender's settings, never a student's campus mailbox password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Example format: "NNU Coursebook <noreply@your-verified-domain.example>"
MAIL_FROM=

# Enable only when serving the website over HTTPS.
COOKIE_SECURE=0

# Request protection: per IP per 60s, per IP per 10s, per visitor per 60s.
MAIL_REQUEST_IP_PER_MINUTE=120
MAIL_REQUEST_IP_BURST=30
MAIL_REQUEST_VISITOR_PER_MINUTE=20
REGISTRATION_REQUEST_IP_PER_MINUTE=120
# Actual mail quotas; hour/day windows start on the first reserved send.
MAIL_CODE_COOLDOWN_SECONDS=60
MAIL_VISITOR_PER_HOUR=10
MAIL_EMAIL_PER_HOUR=10
MAIL_GLOBAL_PER_HOUR=200
MAIL_GLOBAL_PER_DAY=1000
